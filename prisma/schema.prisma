// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Used only by the Prisma CLI (migrate). The running application never reads it and it is never
  // present in Vercel runtime configuration. See docs/DB_WORKFLOW.md.
  directUrl = env("DATABASE_MIGRATION_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                    String        @id @default(cuid())
  email                 String?       @unique
  name                  String?
  password              String?       // Hashed password (nullable for future OAuth)
  role                  UserRole      @default(USER)
  isPremium             Boolean       @default(false)
  emailVerified         Boolean       @default(false)
  emailVerificationToken String?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  // Study tracking
  currentStreak         Int           @default(0)
  longestStreak         Int           @default(0)
  lastStudiedDate       DateTime?     // Date (not datetime) of last study activity
  dailyGoal             Int           @default(5)  // Questions per day target
  interviewDate         DateTime?     // Target interview date for countdown
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  banks                 QuestionBank[]
  sessions              Session[]
  quizzes               Quiz[]
  learningSummaries     LearningSummary[]
  learningInsights      UserLearningInsight?
  bankFolders           BankFolder[]
  questionProgress      UserQuestionProgress[]
  interviews            Interview[]
  machinePrincipals     MachinePrincipal[]
  learner               Learner?
  // Account deletion lifecycle (P2): NULL = normal. Set = DELETION_PENDING until the guarded purge runs.
  deletionRequestedAt   DateTime?
  purgeAfter            DateTime?
  authIdentities        AuthIdentity[]
  devices               Device[]
  accountLinkCodes      AccountLinkCode[]
}

model UserQuestionProgress {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  // SM-2 spaced repetition fields
  nextReviewAt DateTime @default(now())
  interval     Int      @default(1)     // Days until next review
  easeFactor   Float    @default(2.5)   // SM-2 ease factor
  repetitions  Int      @default(0)     // Successful review streak
  lastScore    Float?                   // Last answerQuality score (0-10)
  lastPracticed DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

model QuestionBank {
  id          String           @id @default(cuid())
  userId      String?
  title       String
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  // Restrict: deleting a user must not silently turn their private bank into a shared (null-owner) one.
  user        User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  questions   Question[]
  quizzes     Quiz[]
  sessions    Session[]
  folderItems BankFolderItem[]
  attempts    Attempt[]
  // Maps a client's own stable key (bundled iOS slug, or an imported local id) to this bank. Never an identity
  // by itself: it is how a device that only knows its own ids finds the server bank.
  externalKey String?
  archivedAt  DateTime?

  @@unique([userId, externalKey])
}

model BankFolder {
  id        String           @id @default(cuid())
  userId    String
  title     String
  color     String?
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BankFolderItem[]

  @@index([userId, order])
}

model BankFolderItem {
  id       String       @id @default(cuid())
  folderId String
  bankId   String
  order    Int          @default(0)
  folder   BankFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  bank     QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([folderId, bankId])
  @@index([folderId, order])
  @@index([bankId])
}

enum QuestionType {
  BEHAVIORAL
  TECHNICAL
  DEFINITION
  SCENARIO
  PITCH
}

model Question {
  id         String       @id @default(cuid())
  bankId     String
  text       String
  hint       String?      // Optional answer/hint text from CSV back field
  tags       String[]     // e.g. ["leadership","system-design"]
  difficulty Int          // 1..5
  type       QuestionType @default(BEHAVIORAL) // Auto-detected or user-specified
  bank       QuestionBank @relation(fields: [bankId], references: [id])
  items      SessionItem[]
  quizAttempts QuizAttempt[]
  userProgress UserQuestionProgress[]
  attempts     Attempt[]
  // The text/hint/tags/type above are the projection of the latest revision, so existing readers are unchanged.
  revisions    QuestionRevision[]
  externalKey  String?     // see QuestionBank.externalKey
  archivedAt   DateTime?   // removed from a bank without losing identity or history

  @@unique([bankId, externalKey])
  @@index([bankId])
}

/// An immutable version of a question: what a learner was actually shown. The latest revision is the current one.
model QuestionRevision {
  id         String       @id @default(cuid())
  questionId String
  revision   Int
  text       String
  hint       String?
  tags       String[]
  difficulty Int
  type       QuestionType
  createdAt  DateTime     @default(now())
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts   Attempt[]

  @@unique([questionId, revision])
}

model Session {
  id          String            @id @default(cuid())
  userId      String?
  title       String
  bankId      String?
  extraBankIds String[]         @default([]) // Further banks in a multi-bank session; bankId stays the primary one
  filterTags  String[]          @default([]) // Tags to filter questions by (for weak topics practice)
  isCompleted Boolean           @default(false)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  bank        QuestionBank?     @relation(fields: [bankId], references: [id])
  items       SessionItem[]
  summary     LearningSummary?
  attempts    Attempt[]

  @@index([userId, createdAt])
}

model SessionItem {
  id                String   @id @default(cuid())
  sessionId         String
  questionId        String
  audioUrl          String?
  transcript        String?
  words             Int?
  wpm               Int?
  fillerCount       Int?
  fillerRate        Float?   // per 100 words
  longPauses        Int?     // >800ms
  confidenceScore   Float?   // 0..10 (vocal confidence, 0.5 steps)
  intonationScore   Float?   // 0..10 (pitch variation, expressiveness, 0.5 steps)
  starScore         Float?   // 0..10 (0.5 steps)
  impactScore       Float?   // 0..10 (0.5 steps)
  clarityScore      Float?   // 0..10 (0.5 steps)
  technicalAccuracy Float?   // 0..10 (0.5 steps)
  terminologyUsage  Float?   // 0..10 (0.5 steps)
  questionAnswered  Boolean? // Did the answer address the question?
  answerQuality     Float?   // 0..10 overall answer quality (0.5 steps)
  whatWasRight      String[] // Array of what was right
  whatWasWrong      String[] // Array of what needs improvement
  betterWording     String[] // Array of better wording suggestions (with definitions, examples, clarity)
  dontForget        String[] // Array of important points they forgot to mention
  aiFeedback        String?
  createdAt         DateTime @default(now())
  // Compatibility link to the canonical record. NULL for rows with no learner (unowned sessions) and for
  // rows whose ledger write failed; docs/P1_LEARNER_ATTEMPT_LEDGER.md describes the divergence check.
  attemptId         String?  @unique
  session           Session  @relation(fields: [sessionId], references: [id])
  question          Question @relation(fields: [questionId], references: [id])
  attempt           Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model Quiz {
  id          String      @id @default(cuid())
  userId      String?
  title       String
  description String?
  type        QuizType    @default(SPOKEN) // SPOKEN or WRITTEN
  bankId      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  bank        QuestionBank? @relation(fields: [bankId], references: [id])
  attempts    QuizAttempt[]
}

enum QuizType {
  SPOKEN
  WRITTEN
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  questionId  String
  answer      String?  // Written answer or transcript
  audioUrl    String?  // For spoken quizzes
  transcript  String?  // For spoken quizzes
  score       Float?   // 0..100
  feedback    String?
  hintUsed    Boolean  @default(false) // Whether the user viewed the hint for this question
  startedAt   DateTime @default(now())
  completedAt DateTime?
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  question    Question @relation(fields: [questionId], references: [id])

  @@index([quizId])
}

model LearningSummary {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String   @unique
  bankId          String?
  commonMistakes  Json     // Array of mistake patterns
  frequentlyForgottenPoints Json? // Array of key points consistently forgotten
  weakTags        String[] // Tags with low scores
  strongTags      String[] // Tags with high scores
  recommendedFocus String[] // Tags to revisit
  performanceByTag Json     // Tag -> avg score mapping
  overallScore    Float?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserLearningInsight {
  id                  String   @id @default(cuid())
  userId              String   @unique
  aggregatedWeakTags  String[] // Across all sessions
  aggregatedStrongTags String[] // Across all sessions
  topFocusAreas       String[] // Most recommended
  topForgottenPoints  Json?    // Most frequently forgotten key points across all sessions
  totalSessions       Int      @default(0)
  totalQuestions      Int      @default(0)
  lastUpdated         DateTime @default(now()) @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Interview {
  id          String    @id @default(cuid())
  userId      String
  company     String
  role        String
  round       String?
  startsAt    DateTime
  endsAt      DateTime?
  link        String?
  bookingLink String?
  interviewer String?
  status      String    @default("scheduled") // scheduled | completed | cancelled
  source      String    @default("manual")    // manual | notion | calendar (calendar: designed, not built)
  externalId  String?                         // id in the source system (Notion page id)
  timeZone    String?                         // IANA zone the source gave the time in (display only; startsAt is an instant)
  sourceUpdatedAt DateTime?                   // when the source system last changed this record, not when iPrep synced it
  notes       String?
  folderId    String?                         // BankFolder holding the prep banks (not a FK: folders can be deleted)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, startsAt])
}

/// A non-human credential (MCP server, Notion sync, scripts). It acts as one learner, holds an explicit
/// list of scopes, is revocable and audited, and can never be admin. Only the hash of the token is stored.
model MachinePrincipal {
  id          String         @id @default(cuid())
  name        String         @unique // e.g. "mcp-read", "notion-sync"
  tokenHash   String         @unique // sha256 (hex) of the bearer token
  tokenPrefix String // first characters of the token, for identification in audit rows
  scopes      String[]
  userId      String // the user account whose data this principal acts on
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  // The learner this principal acts on behalf of. A principal is never a learner itself, and it does not
  // inherit learner identity through its user: the binding is explicit and required.
  learnerId   String
  learner     Learner         @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  attempts    Attempt[]
  createdAt   DateTime       @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  audits      MachineAudit[]

  @@index([userId])
  @@index([learnerId])
}

model MachineAudit {
  id          String           @id @default(cuid())
  principalId String
  principal   MachinePrincipal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  method      String
  path        String
  scope       String
  status      Int
  at          DateTime         @default(now())

  @@index([principalId, at])
}

/// Persistent fixed-window counters for security limits (login, registration, expensive routes).
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// ---------------------------------------------------------------------------------------------------------
// Learner and canonical attempt ledger (P1).
//
// "Listening is exposure. Retrieval is evidence. Performance is stronger evidence."
// The learner record describes what the learner has demonstrated, not what content the product has shown them.
//
// Layering:
//   User            credentials and account state (auth). Unchanged.
//   Learner         the stable owner of learning evidence. 1:1 with User today; a later AuthIdentity split moves
//                   credentials without touching a single Attempt.
//   Attempt         one thing the learner did (append-only fact: who, what prompt, where, when).
//   AttemptEvidence what the learner produced (transcript, audio reference, measured delivery metrics).
//   AttemptEvaluation   an interpretation of the evidence by a named, versioned evaluator. Re-evaluation appends.
//   AttemptMeasurement  sparse scores inside an evaluation, optionally tagged with a measurement dimension.
//   Session         groups attempts. It never owns them: deleting a session leaves its attempts in the ledger.
//
// The ledger tables are append-only (database triggers; see the migration). Derived state is recomputable.
// ---------------------------------------------------------------------------------------------------------

model Learner {
  id         String             @id @default(cuid())
  userId     String             @unique
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  goals      Goal[]
  attempts   Attempt[]
  principals MachinePrincipal[]
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

/// What a learner is working towards. Deliberately minimal. Historical attempts have no goal (goalId NULL): no
/// goal is ever invented for data recorded before goals existed.
model Goal {
  id         String     @id @default(cuid())
  learnerId  String
  title      String
  targetDate DateTime?
  status     GoalStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  attempts   Attempt[]

  @@index([learnerId, status])
}

/// Where and how the learner met the prompt. Supports every current surface and the planned ones.
enum AttemptSurface {
  WRITTEN_TO_SPOKEN // written prompt, spoken answer (practice sessions, spoken quizzes)
  LIVE_SPOKEN // live, conversational spoken exchange
  PODCAST_RETRIEVAL // a recall pause inside a podcast episode
  PODCAST_LISTEN // listening only: exposure, never evidence of recall
  CHALLENGE // timed or scored challenge
  INTERVIEW_SIMULATION // mock interview
  TYPED_RETRIEVAL // typed answer (written quizzes, typed recall)
}

enum ResponseMode {
  SPOKEN
  TYPED
  NONE // exposure only: the learner produced nothing
}

model Attempt {
  id               String         @id @default(cuid())
  learnerId        String
  goalId           String?
  surface          AttemptSurface
  responseMode     ResponseMode
  // The prompt as the learner saw it. The question can later be edited or deleted; the attempt stays readable.
  questionId       String?
  promptSnapshot   String
  questionType     String?
  tagsSnapshot     String[]       @default([])
  bankId           String?
  // Grouping only. A session never owns its attempts.
  sessionId        String?
  hintUsed         Boolean?
  // Who recorded it when it was not the learner themselves (a machine principal). Never a learner.
  actorPrincipalId String?
  // practice-api | quiz-api | legacy-backfill
  source           String
  // "SessionItem:<id>" or "QuizAttempt:<id>" for rows that came from legacy tables; makes the backfill idempotent.
  legacyRef        String?        @unique
  occurredAt       DateTime
  recordedAt       DateTime       @default(now())
  // P2 client-created events. The client event id is permanent idempotency: a retried event can never create a
  // second attempt (unique per learner). payloadHash is computed by the server over the immutable fields and
  // only distinguishes a repeat from a conflicting reuse of the id.
  clientEventId    String?
  payloadHash      String?
  deviceId         String?
  questionRevisionId String?
  // The device clock offset at send time; occurredAt itself is never rewritten.
  occurredAtSkewMs Int?
  occurredAtSuspect Boolean       @default(false)
  // What the learner consented to when the event was created. NULL for web and legacy rows. Not an evaluation.
  evaluationRequested Boolean?
  // linked | unlinked | n/a: whether the prompt was resolved to canonical content (never guessed).
  contentLinkage   String         @default("n/a")
  // The client's own references as sent (bundled keys, local ids): provenance for unlinked attempts.
  clientRef        Json?

  learner      Learner              @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  goal         Goal?                @relation(fields: [goalId], references: [id], onDelete: SetNull)
  question     Question?            @relation(fields: [questionId], references: [id], onDelete: SetNull)
  bank         QuestionBank?        @relation(fields: [bankId], references: [id], onDelete: SetNull)
  session      Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  actor        MachinePrincipal?    @relation(fields: [actorPrincipalId], references: [id], onDelete: SetNull)
  evidence     AttemptEvidence?
  evaluations  AttemptEvaluation[]
  measurements AttemptMeasurement[]
  sessionItem  SessionItem?
  device       Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  questionRevision QuestionRevision? @relation(fields: [questionRevisionId], references: [id], onDelete: SetNull)

  @@unique([learnerId, clientEventId])
  @@index([learnerId, occurredAt])
  @@index([questionId])
  @@index([sessionId])
  @@index([goalId])
}

/// What the learner produced. Facts only: no scores, no AI judgement. Every field is nullable because absence
/// is honest (an exposure has no response; an old row may have no audio).
model AttemptEvidence {
  id           String   @id @default(cuid())
  attemptId    String   @unique
  responseText String? // typed answer
  transcript   String? // spoken answer, as transcribed
  // Reference to the stored recording, exactly as recorded at the time (a URL or object key). Not interpreted.
  audioRef     String?
  transcriber  String? // provider/model that produced the transcript; NULL when unknown
  words        Int?
  wpm          Int?
  fillerCount  Int?
  fillerRate   Float? // per 100 words
  longPauses   Int?
  durationMs   Int?
  recordedAt   DateTime @default(now())
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
}

enum EvaluatorKind {
  AI_RUBRIC // a language model scored the answer against a rubric
  DETERMINISTIC // code computed it from the evidence (delivery heuristics)
  HUMAN
  LEGACY_IMPORT // carried over from a table that never recorded who or what produced the numbers
}

enum EvaluationStatus {
  COMPLETED
  FAILED // the evaluator could not run. No measurements. A fallback is never stored as a score.
  SKIPPED // not evaluated on purpose (for example too little to evaluate)
}

/// An interpretation of the evidence. Re-evaluating appends a new row; the latest COMPLETED one is "current".
/// Everything needed to replay or compare evaluators is on the row; unknown values are NULL, never guessed.
model AttemptEvaluation {
  id               String               @id @default(cuid())
  attemptId        String
  kind             EvaluatorKind
  status           EvaluationStatus
  evaluatorVersion String // for example "spoken-answer@1"; "legacy-unversioned" for imports
  rubricVersion    String?
  promptVersion    String?
  provider         String?
  model            String?
  failureReason    String?
  questionAnswered Boolean?
  // Narrative feedback exactly as produced: { whatWasRight, whatWasWrong, betterWording, dontForget, text }.
  feedback         Json?
  // Version of the metric-to-dimension tagging applied to this evaluation's measurements ("dimensions@1").
  dimensionMap     String?
  // The exact text the evaluator saw, only when it differs from the recorded evidence (a corrected transcript).
  evaluatedText    String?
  evaluatedAt      DateTime? // NULL when the original time is unknown
  recordedAt       DateTime             @default(now())
  legacyRef        String?              @unique
  attempt          Attempt              @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  measurements     AttemptMeasurement[]

  @@unique([id, attemptId])
  @@index([attemptId, recordedAt])
}

enum MeasurementDimension {
  RECALL // retrieved it from memory, accurately
  EXPLANATION // explained it clearly in own words
  APPLICATION // used it on a new situation
  DELIVERY // how it was said
  DISCRIMINATION // told it apart from something similar
  EXPOSURE // the learner was shown it. Never counts as evidence of recall.
}

/// One score inside an evaluation. Sparse: only what was actually measured has a row. `dimension` is NULL for
/// numbers that do not honestly belong to one dimension (composite scores, unclassified legacy metrics).
model AttemptMeasurement {
  id           String                @id @default(cuid())
  evaluationId String
  attemptId    String
  dimension    MeasurementDimension?
  metric       String // the name the evaluator gave it, for example "technicalAccuracy"
  value        Float
  scaleMin     Float                 @default(0)
  scaleMax     Float                 @default(10)
  evaluation   AttemptEvaluation     @relation(fields: [evaluationId, attemptId], references: [id, attemptId], onDelete: Restrict)
  attempt      Attempt               @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, metric])
  @@index([attemptId])
  @@index([dimension])
}

// ---------------------------------------------------------------------------------------------------------
// Native identity and sync (P2). See docs/P2_NATIVE_SYNC.md.
// ---------------------------------------------------------------------------------------------------------

/// A way to prove who is acting. Authentication only: whose learning history it is comes from User -> Learner.
/// Never linked by email. At most one active Apple identity per user (partial unique index in the migration).
model AuthIdentity {
  id            String    @id @default(cuid())
  userId        String
  provider      String // "apple"
  subject       String
  emailAtLink   String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  // consent-revoked | account-deleted | user
  revokedReason String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userId])
}

/// Single-use invite for native account creation. Only the hash is stored.
model NativeInvite {
  id           String    @id @default(cuid())
  codeHash     String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  note         String?
}

/// One-time code an existing, signed-in web user creates to link an Apple identity. Only the hash is stored.
model AccountLinkCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

/// A signed-in native app installation. The device id is issued by the server.
model Device {
  id          String         @id @default(cuid())
  userId      String
  platform    String
  appVersion  String?
  createdAt   DateTime       @default(now())
  lastSeenAt  DateTime?
  lastPushAt  DateTime?
  lastCursor  String?
  revokedAt   DateTime?
  // user-logout | refresh-reuse | apple-revoked | deletion-requested | operator
  revokedReason String?
  // A random id the app generates once per installation and keeps for that installation's life. It identifies the
  // INSTALLATION only, never a person or hardware (no IDFV, serial or fingerprint). One user + one installation =
  // one active Device (partial unique index in the migration). NULL for devices created before this existed.
  installId   String?
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokens      NativeRefreshToken[]
  attempts    Attempt[]

  @@index([userId])
}

/// Refresh tokens form a chain per device (the family is the device). Each use rotates the token. Presenting a
/// token that was already rotated is reuse: the device is revoked. Only hashes are stored.
model NativeRefreshToken {
  id           String    @id @default(cuid())
  deviceId     String
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  rotatedAt    DateTime?
  replacedById String?
  revokedAt    DateTime?
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

/// Per-learner change feed for pull sync. `txid` is the writing transaction id: the pull only serves rows from
/// transactions older than every in-flight one, so a cursor can never skip a change that commits late.
model SyncChange {
  id         BigInt   @id @default(autoincrement())
  txid       BigInt   @default(dbgenerated("((pg_current_xact_id())::text)::bigint"))
  learnerId  String
  entityType String
  entityId   String
  kind       String   @default("upsert")
  createdAt  DateTime @default(now())

  @@index([learnerId, txid, id])
}

/// Single row. An operator bumps it after a restore so every client re-pulls from the start.
model SyncEpoch {
  id    Int @id @default(1)
  epoch Int @default(1)
}

/// Diagnostic only. Idempotency never depends on this table.
model SyncEventLog {
  id          String   @id @default(cuid())
  learnerId   String
  deviceId    String?
  eventId     String
  result      String
  errorCode   String?
  payloadHash String?
  receivedAt  DateTime @default(now())

  @@index([learnerId, receivedAt])
  @@index([learnerId, eventId])
}

/// What remains after a purge: counts only, never personal data.
model AccountDeletionReceipt {
  id          String   @id @default(cuid())
  requestedAt DateTime
  purgedAt    DateTime @default(now())
  counts      Json
}
